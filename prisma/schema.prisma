generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  ACCENT_TALK
  TECHNICAL_TALK
  INDUSTRIAL_VISIT
  WORKSHOP
  CERTIFICATION
}

model Event {
  id          String        @id @default(cuid())
  title       String
  category    EventCategory
  date        DateTime
  location    String
  description String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([isActive, date])
}

model MoUApplication {
  id            String   @id @default(cuid())
  institution   String
  contactName   String
  email         String
  phone         String
  department    String?
  notes         String?
  createdAt     DateTime @default(now())
  status        InquiryStatus @default(NEW)
  adminNotes    String?
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}

model ConsultationRequest {
  id          String   @id @default(cuid())
  company     String
  contactName String
  email       String
  teamSize    String?
  interest    String
  notes       String?
  createdAt   DateTime @default(now())
  status      InquiryStatus @default(NEW)
  adminNotes  String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  status    InquiryStatus @default(NEW)
  adminNotes String?
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}


enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String @id @default(cuid())
  tokenHash String @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key       String @id
  count     Int @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ServiceContent {
  id          String @id
  title       String
  tag         String
  description String
  details     String[]
  updatedAt   DateTime @default(now()) @updatedAt
}
